{
  "info": {
    "name": "SmartSpend API v1",
    "description": "Collection kiểm thử API SmartSpend — Graduation Project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:9090" },
    { "key": "jwt_token", "value": "" },
    { "key": "test_username", "value": "testuser01" },
    { "key": "test_email", "value": "test.smartspend@gmail.com" },
    { "key": "test_password", "value": "Test@123456" },
    { "key": "test_otp", "value": "123456" },
    { "key": "test_pin", "value": "123456" },
    { "key": "wallet_stk", "value": "12345678901234" },
    { "key": "bank_account_id", "value": "1" },
    { "key": "transaction_code", "value": "" },
    { "key": "sepay_api_key", "value": "YOUR_SEPAY_API_KEY" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "TC-AUTH-01 Send OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/register/send-otp"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('success true', () => pm.expect(pm.response.json().success).to.be.true);"
              ]
            }
          }]
        },
        {
          "name": "TC-AUTH-02 Verify OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"otp\": \"{{test_otp}}\",\n  \"purpose\": \"REGISTER\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/verify-otp"
          }
        },
        {
          "name": "TC-AUTH-03 Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"otp\": \"{{test_otp}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "if (json.success && json.data?.token) {",
                "  pm.collectionVariables.set('jwt_token', json.data.token);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "TC-AUTH-04 Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Login OK', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Has token', () => pm.expect(json.data.token).to.be.a('string'));",
                "if (json.data?.token) pm.collectionVariables.set('jwt_token', json.data.token);"
              ]
            }
          }]
        },
        {
          "name": "TC-AUTH-06 Setup PIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pinCode\": \"{{test_pin}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/setup-pin"
          }
        },
        {
          "name": "TC-AUTH-07 Verify PIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pinCode\": \"{{test_pin}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/verify-pin"
          }
        }
      ]
    },
    {
      "name": "02 - Wallet",
      "item": [
        {
          "name": "TC-WAL-02 Setup STK",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{wallet_stk}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/wallets/setup-account"
          }
        },
        {
          "name": "TC-WAL-03 Get My Wallet",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/wallets/me"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Has balance', () => {",
                "  const d = pm.response.json().data;",
                "  pm.expect(d).to.have.property('balance');",
                "  pm.expect(d).to.have.property('accountNumber');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "TC-WAL-01 Get Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/user/me"
          }
        }
      ]
    },
    {
      "name": "03 - Bank",
      "item": [
        {
          "name": "TC-BANK-01 Link Bank",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bankCode\": \"970422\",\n  \"bankName\": \"MB Bank\",\n  \"accountNumber\": \"0123456789\"\n}"
            },
            "url": "{{base_url}}/api/v1/bank-accounts"
          }
        },
        {
          "name": "TC-BANK-02 List Banks",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/bank-accounts"
          }
        }
      ]
    },
    {
      "name": "04 - Transaction",
      "item": [
        {
          "name": "TC-TX-01 Top Up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": null,\n  \"amount\": null,\n  \"note\": \"Nap test Postman\",\n  \"categoryId\": null\n}"
            },
            "url": "{{base_url}}/api/v1/transactions/top-up"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const d = pm.response.json().data;",
                "if (d?.transactionCode) pm.collectionVariables.set('transaction_code', d.transactionCode);"
              ]
            }
          }]
        },
        {
          "name": "TC-TX-02 SePay Webhook",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Apikey {{sepay_api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 999001,\n  \"gateway\": \"MB\",\n  \"transactionDate\": \"2026-07-15 10:00:00\",\n  \"accountNumber\": \"77180227052005\",\n  \"content\": \"NAP {{wallet_stk}}\",\n  \"transferType\": \"in\",\n  \"transferAmount\": 100000,\n  \"referenceCode\": \"FT260715TEST\"\n}"
            },
            "url": "{{base_url}}/api/v1/transactions/sepay-webhook"
          }
        },
        {
          "name": "TC-TX-03 Withdraw",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10000,\n  \"bankAccountId\": {{bank_account_id}},\n  \"pinCode\": \"{{test_pin}}\",\n  \"note\": \"Rut test Postman\",\n  \"categoryId\": null\n}"
            },
            "url": "{{base_url}}/api/v1/transactions/withdraw"
          }
        },
        {
          "name": "TC-TX-04 Update Transaction",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Cap nhat tu Postman\",\n  \"categoryId\": null\n}"
            },
            "url": "{{base_url}}/api/v1/transactions/{{transaction_code}}"
          }
        }
      ]
    },
    {
      "name": "05 - Category",
      "item": [
        {
          "name": "TC-CAT-01 Create Group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"An uong\",\n  \"icon\": \"restaurant\",\n  \"color\": \"#EF4444\",\n  \"bgColor\": \"#FEE2E2\"\n}"
            },
            "url": "{{base_url}}/api/v1/categories/groups"
          }
        },
        {
          "name": "TC-CAT-02 Create Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": 1,\n  \"label\": \"Ca phe\",\n  \"icon\": \"cafe\",\n  \"color\": \"#6B7280\",\n  \"bgColor\": \"#F3F4F6\"\n}"
            },
            "url": "{{base_url}}/api/v1/categories/items"
          }
        },
        {
          "name": "TC-CAT GET All",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/categories"
          }
        }
      ]
    },
    {
      "name": "06 - Report & History",
      "item": [
        {
          "name": "TC-HIS-01 History",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/history/transactions"
          }
        },
        {
          "name": "TC-RPT-01 Distribution",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/reports/distribution?type=WITHDRAW&filter=MONTH&date=2026-07-15&groupBy=CATEGORY",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports", "distribution"],
              "query": [
                { "key": "type", "value": "WITHDRAW" },
                { "key": "filter", "value": "MONTH" },
                { "key": "date", "value": "2026-07-15" },
                { "key": "groupBy", "value": "CATEGORY" }
              ]
            }
          }
        },
        {
          "name": "TC-RPT-02 Trend",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/reports/trend?type=WITHDRAW&filter=MONTH&date=2026-07-15",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports", "trend"],
              "query": [
                { "key": "type", "value": "WITHDRAW" },
                { "key": "filter", "value": "MONTH" },
                { "key": "date", "value": "2026-07-15" }
              ]
            }
          }
        }
      ]
    }
  ]
}
